# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
# Sites allowed to call the API, comma separated. On Render: your Vercel URL
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. Each developer uses their own database name
# at the end of the URL, e.g. .../ai-study-planner-sneha
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ai-study-planner-yourname?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# AI for card and quiz generation (server only, never sent to the browser).
# Free key: https://aistudio.google.com -> Get API key. Each developer uses their own key.
LLM_API_KEY=
# Optional. Defaults work with Gemini; to use OpenRouter set LLM_BASE_URL=https://openrouter.ai/api/v1/
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash
