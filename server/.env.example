# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. Each developer uses their own database name
# at the end of the URL, e.g. .../ai-study-planner-sneha
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ai-study-planner-yourname?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# LLM for card and quiz generation (server only, never sent to the browser)
LLM_API_KEY=
