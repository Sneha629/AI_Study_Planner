// AI Study Planner database schema (PRD Section 7)
// Tables use snake_case names in PostgreSQL; Prisma models use camelCase in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FileType {
  pdf
  txt
}

enum CardSource {
  manual
  ai
}

enum Rating {
  again
  hard
  good
  easy
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  email            String   @unique
  passwordHash     String   @map("password_hash")
  // IANA zone like "Asia/Kolkata"; needed for streaks and "today"
  timezone         String   @default("Asia/Kolkata")
  dailyReviewLimit Int      @default(100) @map("daily_review_limit")
  dailyNewLimit    Int      @default(20) @map("daily_new_limit")
  createdAt        DateTime @default(now()) @map("created_at")

  subjects     Subject[]
  reviews      Review[]
  quizAttempts QuizAttempt[]
  streak       Streak?

  @@map("users")
}

model Subject {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  name      String
  examDate  DateTime? @map("exam_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]
  decks Deck[]

  @@index([userId])
  @@map("subjects")
}

model Note {
  id            Int      @id @default(autoincrement())
  subjectId     Int      @map("subject_id")
  fileName      String   @map("file_name")
  fileType      FileType @map("file_type")
  // Raw text kept so cards can be regenerated
  extractedText String   @map("extracted_text")
  createdAt     DateTime @default(now()) @map("created_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cards   Card[]

  @@index([subjectId])
  @@map("notes")
}

model Deck {
  id               Int      @id @default(autoincrement())
  subjectId        Int      @map("subject_id")
  name             String
  // Set when the owner shares the deck (F13)
  shareToken       String?  @unique @map("share_token")
  copiedFromDeckId Int?     @map("copied_from_deck_id")
  createdAt        DateTime @default(now()) @map("created_at")

  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  copiedFrom   Deck?         @relation("DeckCopies", fields: [copiedFromDeckId], references: [id], onDelete: SetNull)
  copies       Deck[]        @relation("DeckCopies")
  cards        Card[]
  quizAttempts QuizAttempt[]

  @@index([subjectId])
  @@map("decks")
}

model Card {
  id           Int        @id @default(autoincrement())
  deckId       Int        @map("deck_id")
  front        String
  back         String
  source       CardSource @default(manual)
  noteId       Int?       @map("note_id")
  // SM-2 state (PRD Section 8.2)
  easeFactor   Float      @default(2.5) @map("ease_factor")
  intervalDays Int        @default(0) @map("interval_days")
  repetitions  Int        @default(0)
  dueDate      DateTime   @default(now()) @map("due_date") @db.Date
  isNew        Boolean    @default(true) @map("is_new")
  createdAt    DateTime   @default(now()) @map("created_at")

  deck    Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([deckId, dueDate])
  @@map("cards")
}

model Review {
  id             Int      @id @default(autoincrement())
  cardId         Int      @map("card_id")
  userId         Int      @map("user_id")
  rating         Rating
  reviewedAt     DateTime @default(now()) @map("reviewed_at")
  intervalBefore Int      @map("interval_before")
  intervalAfter  Int      @map("interval_after")
  easeAfter      Float    @map("ease_after")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@map("reviews")
}

model QuizAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  deckId    Int      @map("deck_id")
  // [{ question, options[4], correct_index }]
  questions Json
  answers   Json?
  score     Int?
  total     Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("quiz_attempts")
}

model Streak {
  userId         Int       @id @map("user_id")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastStudyDate  DateTime? @map("last_study_date") @db.Date
  // ISO week the free skip was used, stored as "2026-W45" so weeks from different years never clash
  freezeUsedWeek String?   @map("freeze_used_week")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}
